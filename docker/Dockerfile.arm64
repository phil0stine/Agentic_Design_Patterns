# syntax=docker/dockerfile:1
# =============================================================
# Offline Autonomy Stack — ARM64 / NVIDIA Jetson (JetPack 7.2)
# Base:    nvcr.io/nvidia/l4t-pytorch:2.12-jp7.2-py3
#          (Ubuntu 24.04, CUDA 13.x, cuDNN 9.x, PyTorch 2.12)
# ROS2:    Jazzy
# GTSAM:   built from source
#
# Verify the NGC tag before building:
#   https://catalog.ngc.nvidia.com/orgs/nvidia/containers/l4t-pytorch
# =============================================================
FROM nvcr.io/nvidia/l4t-pytorch:2.12-jp7.2-py3 AS base

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=jazzy

# ---- System packages ----------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg lsb-release ca-certificates \
    git cmake build-essential ninja-build \
    python3-pip python3-dev \
    python3-setuptools python3-wheel \
    libboost-all-dev libtbb-dev libeigen3-dev \
    libopencv-dev \
    iptables iproute2 \
    && rm -rf /var/lib/apt/lists/*

# ---- ROS2 Jazzy (arm64) -------------------------------------
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
       http://packages.ros.org/ros2/ubuntu noble main" \
    | tee /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
       ros-${ROS_DISTRO}-ros-base \
       ros-${ROS_DISTRO}-nav2-bringup \
       ros-${ROS_DISTRO}-nav2-msgs \
       ros-${ROS_DISTRO}-geometry-msgs \
       ros-${ROS_DISTRO}-sensor-msgs \
       ros-${ROS_DISTRO}-std-msgs \
       ros-${ROS_DISTRO}-action-msgs \
       ros-${ROS_DISTRO}-rosbag2 \
       ros-${ROS_DISTRO}-rosbag2-storage-mcap \
       python3-colcon-common-extensions \
       python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ---- GTSAM (source build) -----------------------------------
# On JetPack 7.2 / L4T, system Eigen may lag; use bundled if needed.
RUN git clone --depth 1 --branch main \
    https://github.com/borglab/gtsam.git /opt/gtsam-src \
    && cmake -S /opt/gtsam-src -B /opt/gtsam-build \
       -DCMAKE_BUILD_TYPE=Release \
       -DGTSAM_BUILD_PYTHON=ON \
       -DGTSAM_PYTHON_VERSION=3 \
       -DGTSAM_USE_SYSTEM_EIGEN=ON \
       -DGTSAM_BUILD_TESTS=OFF \
       -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
       -GNinja \
    && cmake --build /opt/gtsam-build -j$(nproc) --target install \
    && cd /opt/gtsam-build && ninja python-install \
    && rm -rf /opt/gtsam-src /opt/gtsam-build

# PyTorch 2.12 is already included in the NGC base image.
# torchvision may need to be built from source for jp7.2:
# RUN pip3 install --no-cache-dir torchvision --find-links \
#     https://developer.download.nvidia.com/compute/redist/jp/v72/

# ---- Python agent dependencies ------------------------------
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# ---- Application code ---------------------------------------
COPY agent/    /app/agent/
COPY config/   /app/config/
COPY scripts/  /app/scripts/
COPY docker/   /app/docker/

RUN chmod +x /app/scripts/*.sh \
    && chmod +x /app/docker/entrypoint.sh \
    && chmod +x /app/docker/network/restrict_network.sh

WORKDIR /app

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["python3", "-m", "agent.main", "--mode", "sitl", \
     "--goal", "/app/config/goals/example_sitl_goal.yaml"]
