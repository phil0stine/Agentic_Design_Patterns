# Copy to .env and fill in values

# Required
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ROS2
ROS_DOMAIN_ID=0

# SITL
SIMULATOR_HOST=localhost

# BITL
BAG_PATH=/path/to/your/bag/directory
BAG_FILE=recording_name
BAG_RATE=1.0
BAG_LOOP=--loop

# Agent verbosity
AGENT_LOG_LEVEL=INFO

# Network restriction (requires CAP_NET_ADMIN)
RESTRICT_NETWORK=true

# Subnet allowed for ROS2 DDS (loopback always allowed)
ROS_NETWORK_SUBNET=192.168.1.0/24
